<?xml version="1.0" encoding="UTF-8"?>
<!-->
Simple logback config to override apiml configuration coming from dependency
<-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />
    <!-- Tag every record (including forwarded native zo records) with request id and z/OS user -->
    <property name="CONSOLE_LOG_PATTERN" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%X{requestId:-}] [%X{user:-}] %-40.40logger{39} : %m%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <!-- No explicit charset: follow the JVM default so output matches how stdout is tagged
                 (UTF-8 under the Zowe launcher, EBCDIC in a plain z/OS shell). -->
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>
