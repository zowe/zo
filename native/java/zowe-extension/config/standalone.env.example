# Copy to standalone.env next to bin/ (chmod 600) and adjust. Values mirror what the Zowe
# launcher exports for a component; see bin/start.sh for how each one is used.
# The file is sourced by /bin/sh: quote values that contain spaces or ( ) characters.

# Java 25+ home
ZWE_configs_javaHome=/usr/lpp/java/J25.0_64
# Listener
ZWE_configs_port=27610
ZWE_haInstance_hostname=zos.example.com

# TLS: PKCS12 file ...
ZWE_zowe_certificate_keystore_type=PKCS12
ZWE_zowe_certificate_keystore_file=/u/user1/zo-rest/config/keystore.p12
ZWE_zowe_certificate_keystore_password=change-me
ZWE_zowe_certificate_keystore_alias=zo-rest
ZWE_zowe_certificate_truststore_type=PKCS12
ZWE_zowe_certificate_truststore_file=/u/user1/zo-rest/config/keystore.p12
ZWE_zowe_certificate_truststore_password=change-me
# ... or a SAF keyring (the caller needs access to it, including the private key):
# ZWE_zowe_certificate_keystore_type=JCERACFKS
# ZWE_zowe_certificate_keystore_file=safkeyring://OWNER/RING
# ZWE_zowe_certificate_keystore_alias=LABEL
# ZWE_zowe_certificate_truststore_type=JCERACFKS
# ZWE_zowe_certificate_truststore_file=safkeyring://OWNER/RING
# ... e.g. sharing the Zowe server's ring (alias = the Zowe server certificate label):
# ZWE_zowe_certificate_keystore_type=JCERACFKS
# ZWE_zowe_certificate_keystore_file=safkeyring://ZWESVUSR/ZOWEKRNG
# ZWE_zowe_certificate_keystore_alias=<zowe-server-cert-label>
# ZWE_zowe_certificate_truststore_type=JCERACFKS
# ZWE_zowe_certificate_truststore_file=safkeyring://ZWESVUSR/ZOWEKRNG
ZWE_zowe_verifyCertificates=STRICT

# APIML: false runs a private, unregistered instance. To register, set true and provide:
ZO_APIML_ENABLED=false
# ZWE_DISCOVERY_SERVICES_LIST=https://zos.example.com:7553/eureka/
# ZWE_zowe_externalPort=7554
# Required when another zo instance is already registered as "zo". Gateway URLs then become
# https://<gateway>/<serviceId>/api/v1/... (lowercase letters/digits, start with a letter).
# ZO_SERVICE_ID=zostc
# ZO_SERVICE_TITLE="zo REST API (started task)"

# Optional job name for the JVM address space (8 characters max)
# ZWE_zowe_job_prefix=USER1
