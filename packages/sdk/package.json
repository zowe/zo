{
  "name": "@zowe/zowex-for-zowe-sdk",
  "version": "1.1.0",
  "main": "lib/index.js",
  "scripts": {
    "generate-constants": "tsx generateConstants.ts",
    "build": "npm run generate-constants && tsc -b",
    "clean": "tsc -b --clean && rimraf tsconfig.tsbuildinfo",
    "lint": "npx @biomejs/biome check --write src tests",
    "test": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage",
    "package": "npm pack --pack-destination=../../dist",
    "typedoc": "typedoc src/index.ts --out ../../doc/typedoc",
    "watch": "tsc -b -w"
  },
  "keywords": [],
  "author": "Zowe",
  "license": "EPL-2.0",
  "homepage": "https://github.com/zowe/zowex/tree/main/packages/sdk#README",
  "bugs": {
    "url": "https://github.com/zowe/zowex/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zowe/zowex"
  },
  "description": "Zowe Remote SSH APIs for Zowe SDK",
  "files": [
    "bin",
    "lib"
  ],
  "publishConfig": {
    "registry": "https://zowe.jfrog.io/zowe/api/npm/npm-local-release/"
  },
  "dependencies": {
    "base64-stream": "^1.0.0",
    "es-toolkit": "^1.39.10",
    "node-ssh": "^13.2.0",
    "semver": "^7.8.5",
    "ssh-config": "^5.0.3",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/base64-stream": "^1.0.5",
    "@types/node": "^22.10.7",
    "@types/semver": "^7.7.1",
    "@types/ssh2": "^1.15.4",
    "rxjs": "^7.8.2",
    "typedoc": "^0.27.6",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "russh": "0.1.37"
  },
  "peerDependencies": {
    "@zowe/imperative": "^8.39.0",
    "@zowe/zos-uss-for-zowe-sdk": "^8.39.0"
  }
}
